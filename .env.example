# SmartCare AI - Environment Configuration
# Add your Firebase credentials here to enable live cloud Firestore & Firebase Auth.
# If left empty, SmartCare AI automatically runs in High-Fidelity Local Sync Mode
# with multi-tab real-time updates and fallback demo data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
